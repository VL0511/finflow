{
  "Worker": {
    "Processing": {
      "MaxTransientAttempts": 6,
      "MaxPersistentAttempts": 3,
      "BaseDelay": "00:00:00.100",
      "MaxDelay": "00:00:05"
    },
    "Recovery": {
      "Enabled": true,
      "Interval": "00:00:30",
      "StaleAfter": "00:02:00",
      "BatchSize": 50
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
